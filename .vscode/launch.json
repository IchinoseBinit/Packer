    "version": "0.2.0",
    "configurations": [
        {
            "name": "packer",
            "request": "launch",
            "type": "dart",
            "args": [
                "--target",
                "lib/main.dart",
                "--dart-define=APIType=staging"
            ]
        },
        {
            "name": "packer (PROD)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--target",
                "lib/main.dart",
                "--dart-define=APIType=production"
            ]
        },
        {
            "name": "packer (PROD) Release",
            "request": "launch",
            "flutterMode": "release",
            "type": "dart",
            "args": [
                
                "--target",
                "lib/main.dart",
                "--dart-define=APIType=production"
            ]
        },
        {
            "name": "packer (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--target",
                "lib/main.dart",
                "--dart-define=APIType=staging"
            ]
        },
        {
            "name": "packer (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--target",
                "lib/main.dart",
                "--dart-define=APIType=production"
            ]
        }
    ]
}